{
  "name": "tontinemoney",
  "private": true,
  "version": "0.1.0",
  "description": "Plateforme SaaS de gestion de tontines avec wallet, KYC, paiements et conformit\u00e9",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@tontine/api --filter=@tontine/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int --concurrency=1",
    "test:e2e": "pnpm --filter @tontine/web test:e2e",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @tontine/database db:generate",
    "db:migrate": "pnpm --filter @tontine/database db:migrate",
    "db:migrate:test": "pnpm --filter @tontine/database db:migrate:test",
    "db:migration:new": "pnpm --filter @tontine/database db:migration:new",
    "db:seed": "pnpm --filter @tontine/database db:seed",
    "db:reset": "pnpm --filter @tontine/database db:reset",
    "secrets:scan": "node infrastructure/scripts/scan-secrets.mjs",
    "keys:generate": "node infrastructure/scripts/generate-dev-keys.mjs",
    "db:migrate:check": "pnpm --filter @tontine/database db:migrate:check"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "turbo": "2.11.4",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@swc/core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
