# TontineMoney — configuration locale de développement.
# Toutes les valeurs ci-dessous sont FACTICES (dev-only). N'y mettez jamais de secret réel.

NODE_ENV=development
LOG_LEVEL=info

# --- API ---
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000

# --- Base de données (docker compose) ---
DATABASE_URL=postgresql://tontine:tontine@localhost:5432/tontinemoney?schema=public
DATABASE_URL_TEST=postgresql://tontine:tontine@localhost:5432/tontinemoney_test?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379
# memory | redis (memory = sans Redis, pour tests / démo minimale)
KV_DRIVER=redis

# --- Bus d'événements ---
# inprocess (processus unique) | postgres (journal partagé, sans courtier, A-55) | kafka (Redpanda).
# Services extraits (EXTRACTED_SERVICES) : postgres ou kafka obligatoire.
EVENT_TRANSPORT=postgres
# Groupe de consommateurs de ce processus (transport postgres) ; chaque service a le sien
EVENT_GROUP=api
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=tontinemoney-api
KAFKA_GROUP_ID=tontinemoney-api
KAFKA_TOPIC_PARTITIONS=3
# Producteur idempotent : false (refusé par Redpanda avec kafkajs ; doublons neutralisés par l'inbox)
KAFKA_IDEMPOTENT_PRODUCER=false
# Tentatives de traitement d'un message avant rejet (platform.event_dead_letters + tontinemoney.dead-letter.v1)
EVENT_CONSUMER_MAX_ATTEMPTS=3
OUTBOX_POLL_INTERVAL_MS=250

# --- Authentification ---
# Laisser vides en dev : une paire RSA est générée dans .keys/ au premier démarrage.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_KEY_ID=
JWT_ISSUER=tontinemoney
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
BCRYPT_COST=12
COOKIE_SECURE=false

# --- Chiffrement applicatif (AES-256-GCM, 32 octets en base64) — valeur dev-only ---
DATA_ENCRYPTION_KEY=ZGV2LW9ubHktZGF0YS1lbmNyeXB0aW9uLWtleS0zMmI=

# --- Stockage des documents KYC ---
# local | s3
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_DIR=./storage/kyc
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_KYC=kyc-documents
S3_ACCESS_KEY=minio-dev
S3_SECRET_KEY=minio-dev-secret

# --- Communications ---
# smtp (Mailpit) | memory
EMAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="TontineMoney <no-reply@tontinemoney.local>"
# simulated (seul adaptateur disponible)
SMS_DRIVER=simulated

# --- Paiements (PSP simulé uniquement) ---
PSP_DEFAULT_PROVIDER=simulated
PSP_WEBHOOK_SECRET=dev-only-webhook-secret-change-me
# Appels internes signés (Payment Gateway → Payment Service). Valeur dev-only interdite en production.
INTERNAL_SERVICE_SECRET=dev-only-internal-service-secret-change-me
# Webhooks du PSP simulé : http = via le Payment Gateway (:8090), inprocess = sans gateway
PSP_WEBHOOK_DELIVERY=http
PAYMENT_GATEWAY_URL=http://localhost:8090
PSP_WEBHOOK_TOLERANCE_SECONDS=300
# Squelettes Flutterwave / Paystack : TOUJOURS désactivés (aucune transaction réelle). Laisser vide.
FLUTTERWAVE_WEBHOOK_HASH=
PAYSTACK_SECRET_KEY=

# --- Réconciliation : alerte si l'écart cumulé (unités mineures) dépasse ce seuil ---
RECONCILIATION_ALERT_THRESHOLD_MINOR=0

# --- Tâches planifiées ---
SCHEDULER_ENABLED=true

# --- Observabilité ---
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# Build de démonstration (next build + next start) : affiche les outils du simulateur PSP/SMS
NEXT_PUBLIC_ENABLE_SIMULATORS=true

# --- API Gateway (apps/api-gateway) : point d'entrée unique des clients ---
GATEWAY_PORT=8080
# Service par défaut (apps/api) ; services extraits : GATEWAY_ROUTES=[{"prefix":"/api/v1/…/","upstream":"http://…"}]
API_UPSTREAM_URL=http://localhost:4000
GATEWAY_ROUTES=[{"prefix":"/api/v1/reports/","upstream":"http://localhost:4100"},{"prefix":"/api/v1/tontines/*/reports","upstream":"http://localhost:4100"},{"prefix":"/api/v1/admin/dashboard","upstream":"http://localhost:4100"}]
# Le web (Next.js) appelle le gateway ; valeur prise en compte au build du web
API_URL=http://localhost:8080
# Proxys de confiance devant le gateway : 1 en local (Next.js), 0 si le gateway est en frontal
GATEWAY_TRUST_PROXY_HOPS=1
GATEWAY_RATE_LIMIT_PER_MINUTE=600
GATEWAY_AUTH_RATE_LIMIT_PER_MINUTE=60
GATEWAY_UPSTREAM_TIMEOUT_MS=15000

# --- Payment Gateway (apps/payment-gateway) : webhooks PSP → Payment Service ---
PAYMENT_GATEWAY_PORT=8090
PAYMENT_SERVICE_URL=http://localhost:4000
PAYMENT_GATEWAY_PROVIDERS=["simulated","simulated-backup"]
# 0 : le gateway reçoit directement les PSP (X-Forwarded-For ignoré)
PAYMENT_GATEWAY_TRUST_PROXY_HOPS=0

# --- Extraction des services (étape 7, A-55) ---
# Domaines servis par leur propre processus (retirés du monolithe). Vide : monolithe seul
# (penser alors à GATEWAY_ROUTES=[] et, au besoin, EVENT_TRANSPORT=inprocess).
EXTRACTED_SERVICES=reporting
REPORTING_SERVICE_PORT=4100
# Nom de ce processus (appels internes signés) et services autorisés à appeler ses ports
SERVICE_NAME=api
INTERNAL_PORT_CALLERS=reporting
# Propriétaire des ports pour un service extrait (monolithe tant que le domaine n'est pas extrait)
PORTS_UPSTREAM_URL=http://localhost:4000
