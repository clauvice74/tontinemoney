{
  "name": "@tontine/platform",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@tontine/auth": "workspace:*",
    "@tontine/config": "workspace:*",
    "@tontine/contracts": "workspace:*",
    "@tontine/database": "workspace:*",
    "@tontine/events": "workspace:*",
    "ioredis": "5.8.2",
    "kafkajs": "2.2.4",
    "pino": "9.14.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6",
    "cron": "4.3.3",
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.6",
    "@swc/core": "1.13.5",
    "@tontine/eslint-config": "workspace:*",
    "@tontine/typescript-config": "workspace:*",
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.7",
    "vitest": "3.2.4"
  }
}
