// ============================================================================
// Plateforme
// ============================================================================

model OutboxEvent {
  id            String       @id @db.Uuid
  eventType     String
  eventVersion  Int
  aggregateType String
  aggregateId   String
  producer      String
  correlationId String
  causationId   String?
  payload       Json
  occurredAt    DateTime     @db.Timestamptz(3)
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @db.Timestamptz(3)
  lastError     String?
  publishedAt   DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  seq           BigInt       @default(autoincrement())

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
  @@index([eventType])
  @@map("outbox_events")
}

model ProcessedEvent {
  consumer    String
  eventId     String   @db.Uuid
  processedAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([consumer, eventId])
  @@map("processed_events")
}

model IdempotencyKey {
  id             String            @id @default(uuid()) @db.Uuid
  scope          String
  key            String
  userId         String            @db.Uuid
  requestHash    String
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime          @db.Timestamptz(3)

  @@unique([scope, userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Journal d'audit transverse — append-only (trigger).
model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  actorId       String?     @db.Uuid
  actorRole     String?
  action        String
  resourceType  String
  resourceId    String?
  result        AuditResult
  ip            String?
  userAgent     String?
  country       String?
  correlationId String?
  metadata      Json?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
  @@index([result, createdAt])
  @@map("audit_logs")
}

model JobRun {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  trigger    String
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  status     String
  summary    Json?

  @@index([name, startedAt])
  @@map("job_runs")
}

// ============================================================================
// Auth
// ============================================================================

model User {
  id                String                @id @default(uuid()) @db.Uuid
  email             String?               @unique @db.Citext
  phone             String?               @unique
  passwordHash      String?
  role              PlatformRole          @default(MEMBER)
  status            UserStatus
  firstName         String
  lastName          String
  countryCode       String?               @db.Char(2)
  language          String?
  preferredChannel  CommunicationChannel?
  mfaEnabled        Boolean               @default(false)
  mfaType           MfaType?
  mfaSecretEnc      String?
  mfaPendingSecretEnc String?
  failedLoginCount  Int                   @default(0)
  lockedUntil       DateTime?             @db.Timestamptz(3)
  lockReason        String?
  lastLoginAt       DateTime?             @db.Timestamptz(3)
  createdById       String?               @db.Uuid
  /// A-04 : tontine réservée par le super-admin lors de la création d'un admin délégué.
  delegatedTontineName String?
  delegatedTontineUsed Boolean            @default(false)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)

  passwordHistory PasswordHistory[]
  tokens          AuthToken[]
  sessions        RefreshSession[]
  recoveryCodes   RecoveryCode[]
  knownDevices    KnownDevice[]
  accessRequests  AccessRequest[]

  @@index([status])
  @@map("auth_users")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("auth_password_history")
}

model AuthToken {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  type        AuthTokenType
  tokenHash   String
  expiresAt   DateTime      @db.Timestamptz(3)
  consumedAt  DateTime?     @db.Timestamptz(3)
  revokedAt   DateTime?     @db.Timestamptz(3)
  attempts    Int           @default(0)
  lockedUntil DateTime?     @db.Timestamptz(3)
  metadata    Json?
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, type, createdAt])
  @@map("auth_tokens")
}

model RefreshSession {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  familyId          String    @db.Uuid
  tokenHash         String    @unique
  deviceFingerprint String
  userAgent         String
  ip                String
  mfaUsed           Boolean   @default(false)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt        DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime  @db.Timestamptz(3)
  rotatedAt         DateTime? @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  revokedReason     String?
  replacedById      String?   @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("auth_refresh_sessions")
}

model LoginAttempt {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @db.Uuid
  identifierHash String
  ip             String
  userAgent      String
  success        Boolean
  reason         String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([ip, createdAt])
  @@map("auth_login_attempts")
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_recovery_codes")
}

model KnownDevice {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  fingerprint String
  firstSeenAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime @default(now()) @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@map("auth_known_devices")
}

model AccessRequest {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @db.Uuid
  invitationCodeHash  String?
  requestedTontineName String?
  targetTontineId     String?             @db.Uuid
  ipHash              String?
  status              AccessRequestStatus @default(PENDING)
  decisionReason      String?
  decidedById         String?             @db.Uuid
  decidedAt           DateTime?           @db.Timestamptz(3)
  expiresAt           DateTime            @db.Timestamptz(3)
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetTontineId, status])
  @@map("auth_access_requests")
}

// ============================================================================
// Membres
// ============================================================================

model Member {
  id                String           @id @db.Uuid
  firstName         String
  lastName          String
  email             String?          @db.Citext
  phone             String?
  countryCode       String?          @db.Char(2)
  countrySource     String?
  region            String?
  city              String?
  address           String?
  dateOfBirth       DateTime?        @db.Date
  gender            Gender?
  language          String
  timezone          String
  status            MemberStatus     @default(PENDING)
  kycLevel          KycLevel         @default(NONE)
  complianceStatus  ComplianceStatus @default(COMPLIANT)
  profilePhotoRef   String?
  notificationPrefs Json
  metadata          Json?
  lastActivityAt    DateTime?        @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  version           Int              @default(1)

  auditLogs MemberAuditLog[]

  @@index([status])
  @@index([kycLevel])
  @@map("mbr_members")
}

/// Journal des modifications de profil — append-only (trigger).
model MemberAuditLog {
  id            String            @id @default(uuid()) @db.Uuid
  memberId      String            @db.Uuid
  action        MemberAuditAction
  changedBy     String?           @db.Uuid
  changedByRole ActorRole
  trigger       String?
  oldValues     Json?
  newValues     Json?
  ipAddress     String?
  deviceInfo    String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  member        Member            @relation(fields: [memberId], references: [id])

  @@index([memberId, createdAt])
  @@map("mbr_audit_logs")
}

// ============================================================================
// KYC
// ============================================================================

model KycRequest {
  id                  String             @id @default(uuid()) @db.Uuid
  memberId            String             @db.Uuid
  targetLevel         KycLevel
  status              KycRequestStatus   @default(SUBMITTED)
  documentType        KycDocumentType
  documentCountry     String?            @db.Char(2)
  documentNumberHash  String?
  documentExpiresAt   DateTime?          @db.Date
  extracted           Json?
  livenessToken       String?
  incomeSource        String?
  rejectCategory      KycRejectCategory?
  rejectReason        String?
  decidedBy           String?
  decidedAt           DateTime?          @db.Timestamptz(3)
  submittedAt         DateTime           @default(now()) @db.Timestamptz(3)
  processedAt         DateTime?          @db.Timestamptz(3)
  slaDueAt            DateTime?          @db.Timestamptz(3)
  expiryWarnings      Json?
  retentionUntil      DateTime           @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)

  documents    KycDocument[]
  checks       KycCheck[]
  agentActions KycAgentAction[]

  @@index([memberId, submittedAt])
  @@index([status, submittedAt])
  @@index([documentExpiresAt])
  @@map("kyc_requests")
}

model KycDocument {
  id           String      @id @default(uuid()) @db.Uuid
  requestId    String      @db.Uuid
  memberId     String      @db.Uuid
  kind         KycFileKind
  storageKey   String      @unique
  mimeType     String
  sizeBytes    Int
  sha256       String
  width        Int?
  height       Int?
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  request      KycRequest  @relation(fields: [requestId], references: [id])

  @@index([memberId])
  @@map("kyc_documents")
}

model KycCheck {
  id         String          @id @default(uuid()) @db.Uuid
  requestId  String          @db.Uuid
  step       KycCheckStep
  outcome    KycCheckOutcome
  score      Float?
  details    Json?
  durationMs Int?
  attempts   Int             @default(1)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  request    KycRequest      @relation(fields: [requestId], references: [id])

  @@index([requestId])
  @@map("kyc_checks")
}

model KycAgentAction {
  id        String             @id @default(uuid()) @db.Uuid
  requestId String             @db.Uuid
  agentId   String             @db.Uuid
  action    String
  category  KycRejectCategory?
  comment   String
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  request   KycRequest         @relation(fields: [requestId], references: [id])

  @@index([requestId])
  @@map("kyc_agent_actions")
}

model KycBiometricTemplate {
  memberId  String   @id @db.Uuid
  requestId String   @db.Uuid
  template  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("kyc_biometric_templates")
}

model KycDuplicateAlert {
