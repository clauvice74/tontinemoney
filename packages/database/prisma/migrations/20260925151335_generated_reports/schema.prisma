// TontineMoney — schéma de données (monolithe modulaire).
// Conventions : tables snake_case préfixées par domaine, colonnes camelCase,
// montants BIGINT en unités mineures (suffixe Minor), horodatages timestamptz.
// Contraintes non exprimables ici (CHECK, triggers append-only, trigram) : migrations SQL.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

// L'URL de connexion est fournie par prisma.config.ts (Prisma 7).
// Extensions pg_trgm et citext : créées par la migration initiale.
datasource db {
  provider = "postgresql"
}

