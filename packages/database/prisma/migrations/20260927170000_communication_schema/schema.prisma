  confirmedBy String   @db.Uuid
  comment     String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([memberId, listName, entryId])
  @@map("kyc_aml_whitelist")
  @@schema("kyc")
}

// ============================================================================
// Tontines
// ============================================================================

model Tontine {
  id                    String           @id @default(uuid()) @db.Uuid
  name                  String
  type                  TontineType      @default(SIMPLE_ROTATIVE)
  status                TontineStatus    @default(DRAFT)
  contributionMinor     BigInt
  currency              String           @db.Char(3)
  frequency             TontineFrequency
  frequencyDetail       Json
  maxMembers            Int
  startDate             DateTime         @db.Date
  timezone              String
  drawMode              DrawMode
  graceDays             Int
  lateFeeBps            Int
  suspendAfter          Int
  defaultAfterDays      Int              @default(7)
  entryFeeMinor         BigInt           @default(0)
  collationMinor        BigInt           @default(0)
  incompletePolicy      IncompletePolicy @default(POSTPONE)
  createdById           String           @db.Uuid
  createdByDelegation   Boolean          @default(false)
  invitationLinkHash    String?
  invitationLinkExpires DateTime?        @db.Timestamptz(3)
  drawOrder             Json?
  drawProof             String?
  drawSeedHash          String?
  drawnAt               DateTime?        @db.Timestamptz(3)
  totalCycles           Int?
  currentCycleNumber    Int?
  poolWalletId          String?          @db.Uuid
  reserveWalletId       String?          @db.Uuid
  pausedReason          String?
  startedAt             DateTime?        @db.Timestamptz(3)
  completedAt           DateTime?        @db.Timestamptz(3)
  cancelledAt           DateTime?        @db.Timestamptz(3)
  archivedUntil         DateTime?        @db.Timestamptz(3)
  finalReportRef        String?
  lastStartCheckAt      DateTime?        @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)
  version               Int              @default(1)

  members          TontineMember[]
  invitations      TontineInvitation[]
  cycles           TontineCycle[]
  priorityRequests PriorityRequest[]

  @@unique([createdById, name])
  @@index([status, startDate])
  @@map("ton_tontines")
  @@schema("tontines")
}

model TontineMember {
  id                  String              @id @default(uuid()) @db.Uuid
  tontineId           String              @db.Uuid
  memberId            String              @db.Uuid
  role                TontineMemberRole   @default(MEMBER)
  status              TontineMemberStatus @default(ACTIVE)
  position            Int?
  joinedAt            DateTime            @default(now()) @db.Timestamptz(3)
  entryFeePaid        Boolean             @default(false)
  entryFeeTxId        String?             @db.Uuid
  consecutiveDefaults Int                 @default(0)
  receivedPayout      Boolean             @default(false)
  registeredById      String?             @db.Uuid
  decisionReason      String?
  decidedById         String?             @db.Uuid
  decidedAt           DateTime?           @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)
  tontine             Tontine             @relation(fields: [tontineId], references: [id])

  @@unique([tontineId, memberId])
  @@index([memberId])
  @@index([tontineId, status])
  @@map("ton_members")
  @@schema("tontines")
}

model TontineInvitation {
  id             String            @id @default(uuid()) @db.Uuid
  tontineId      String            @db.Uuid
  channel        InvitationChannel
  targetEmail    String?           @db.Citext
  targetPhone    String?
  invitedUserId  String?           @db.Uuid
  /// SHA-256 du code secret porté par le lien (le code en clair n'est jamais stocké)
  codeHash       String?           @unique
  status         InvitationStatus  @default(PENDING)
  invitedById    String            @db.Uuid
  expiresAt      DateTime          @db.Timestamptz(3)
  respondedAt    DateTime?         @db.Timestamptz(3)
  respondedById  String?           @db.Uuid
  declineReasons Json?
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  tontine        Tontine           @relation(fields: [tontineId], references: [id])

  @@index([tontineId, status])
  @@index([invitedUserId, status])
  @@map("ton_invitations")
  @@schema("tontines")
}

model TontineCycle {
  id               String         @id @default(uuid()) @db.Uuid
  tontineId        String         @db.Uuid
  number           Int
  status           CycleStatus    @default(PENDING)
  beneficiaryId    String?        @db.Uuid
  startDate        DateTime       @db.Date
  dueDate          DateTime       @db.Date
  expectedMinor    BigInt         @default(0)
  collectedMinor   BigInt         @default(0)
  payoutMinor      BigInt?
  payoutTxId       String?        @db.Uuid
  partialPayout    Boolean        @default(false)
  beneficiaryProof String?
  postponedCount   Int            @default(0)
  startedAt        DateTime?      @db.Timestamptz(3)
  completedAt      DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  tontine          Tontine        @relation(fields: [tontineId], references: [id])
  contributions    Contribution[]

  @@unique([tontineId, number])
  @@index([status, dueDate])
  @@map("ton_cycles")
  @@schema("tontines")
}

model Contribution {
  id            String             @id @default(uuid()) @db.Uuid
  cycleId       String             @db.Uuid
  tontineId     String             @db.Uuid
  memberId      String             @db.Uuid
  amountMinor   BigInt
  penaltyMinor  BigInt             @default(0)
  penaltyPaid   Boolean            @default(false)
  penaltyTxId   String?            @db.Uuid
  status        ContributionStatus @default(PENDING)
  dueDate       DateTime           @db.Date
  graceUntil    DateTime           @db.Date
  defaultAt     DateTime           @db.Date
  paidAt        DateTime?          @db.Timestamptz(3)
  transactionId String?            @db.Uuid
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)
  cycle         TontineCycle       @relation(fields: [cycleId], references: [id])

  @@unique([cycleId, memberId])
  @@index([tontineId, memberId])
  @@index([status, graceUntil])
  @@map("ton_contributions")
  @@schema("tontines")
}

model PriorityRequest {
  id          String                @id @default(uuid()) @db.Uuid
  tontineId   String                @db.Uuid
  memberId    String                @db.Uuid
  reason      String
  status      PriorityRequestStatus @default(PENDING)
  cycleNumber Int?
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  tontine     Tontine               @relation(fields: [tontineId], references: [id])

  @@index([tontineId, status])
  @@map("ton_priority_requests")
  @@schema("tontines")
}

// ============================================================================
// Wallets & grand livre
// ============================================================================

model Wallet {
  id            String          @id @default(uuid()) @db.Uuid
  ownerType     WalletOwnerType
  memberId      String?         @unique @db.Uuid
  tontineId     String?         @db.Uuid
  systemCode    String?
  currency      String          @db.Char(3)
  balanceMinor  BigInt          @default(0)
  blockedMinor  BigInt          @default(0)
  allowNegative Boolean         @default(false)
  status        WalletStatus    @default(ACTIVE)
  version       Int             @default(1)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  movements     WalletMovement[]
  holds         WalletHold[]
  statusHistory WalletStatusHistory[]

  @@unique([systemCode, currency])
  @@unique([tontineId, ownerType])
  @@map("wal_wallets")
  @@schema("wallets")
}

/// Écritures du grand livre — append-only (trigger).
model WalletMovement {
  id             String          @id @default(uuid()) @db.Uuid
  walletId       String          @db.Uuid
  transactionId  String?         @db.Uuid
  holdId         String?         @db.Uuid
  type           MovementType
  amountMinor    BigInt
  balanceAfter   BigInt
  availableAfter BigInt
  context        MovementContext
  contextRef     String?
  description    String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  seq            BigInt          @default(autoincrement())
  wallet         Wallet          @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt(sort: Desc)])
  @@index([transactionId])
  @@map("wal_movements")
  @@schema("wallets")
}

model WalletHold {
  id             String          @id @default(uuid()) @db.Uuid
  walletId       String          @db.Uuid
  amountMinor    BigInt
  context        MovementContext
  referenceId    String?
  status         HoldStatus      @default(ACTIVE)
  idempotencyKey String          @unique
  expiresAt      DateTime        @db.Timestamptz(3)
  resolvedAt     DateTime?       @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  wallet         Wallet          @relation(fields: [walletId], references: [id])

  @@index([status, expiresAt])
  @@index([walletId, status])
  @@map("wal_holds")
  @@schema("wallets")
}

model WalletStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  walletId    String       @db.Uuid
  oldStatus   WalletStatus
  newStatus   WalletStatus
  reason      String
  triggeredBy String
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  wallet      Wallet       @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@map("wal_status_history")
  @@schema("wallets")
}

// ============================================================================
// Transactions
// ============================================================================

model Transaction {
  id                  String                 @id @default(uuid()) @db.Uuid
  idempotencyKey      String                 @unique
  type                TransactionType
  status              TransactionStatus      @default(PENDING)
  amountMinor         BigInt
  currency            String                 @db.Char(3)
  initiatorId         String?                @db.Uuid
  beneficiaryId       String?                @db.Uuid
  sourceWalletId      String?                @db.Uuid
  destinationWalletId String?                @db.Uuid
  holdId              String?                @db.Uuid
  contextType         TransactionContextType
  contextId           String?
  description         String?
  metadata            Json
  rejectionRule       String?
  rejectionReason     String?
  failureCode         String?
  failureReason       String?
  reversalOfId        String?                @unique @db.Uuid
  createdAt           DateTime               @default(now()) @db.Timestamptz(3)
  validatedAt         DateTime?              @db.Timestamptz(3)
  completedAt         DateTime?              @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @db.Timestamptz(3)

  @@index([initiatorId, createdAt])
  @@index([beneficiaryId, createdAt])
  @@index([contextType, contextId])
  @@index([status, createdAt])
  @@map("trx_transactions")
  @@schema("transactions")
}

/// Journal d'audit des transactions — append-only, conservation 7 ans (US-6.5).
model TransactionAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @db.Uuid
  action        String
  result        String
  actorId       String?  @db.Uuid
  ip            String?
  device        String?
  userAgent     String?
  country       String?
  details       Json?
  retainUntil   DateTime @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([transactionId, createdAt])
  @@map("trx_audit_logs")
  @@schema("transactions")
}

model ReconciliationReport {
  id               String             @id @default(uuid()) @db.Uuid
  kind             ReconciliationKind
  businessDate     DateTime           @db.Date
  status           String
  checkedCount     Int
  discrepancyCount Int
  thresholdMinor   BigInt             @default(0)
  alert            Boolean            @default(false)
  details          Json
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)

  @@index([kind, businessDate])
  @@map("trx_reconciliation_reports")
  @@schema("transactions")
}

// ============================================================================
// Paiements (PSP)
// ============================================================================

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  type              PaymentType
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amountMinor       BigInt
  feeMinor          BigInt        @default(0)
  currency          String        @db.Char(3)
  provider          String
  providerReference String?       @unique
  memberId          String        @db.Uuid
  walletId          String        @db.Uuid
  destinationMasked String?
  destinationEnc    String?
  transactionId     String?       @db.Uuid
  holdId            String?       @db.Uuid
  idempotencyKey    String        @unique
  redirectUrl       String?
  refundOfId        String?       @db.Uuid
  errorCode         String?
  errorMessage      String?
  retryCount        Int           @default(0)
  fallbackUsed      Boolean       @default(false)
  nextPollAt        DateTime?     @db.Timestamptz(3)
  expiresAt         DateTime      @db.Timestamptz(3)
  completedAt       DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  statusHistory PaymentStatusHistory[]

  @@index([memberId, createdAt])
  @@index([status, nextPollAt])
  @@map("pay_payments")
  @@schema("payments")
}

model PaymentStatusHistory {
  id         String         @id @default(uuid()) @db.Uuid
  paymentId  String         @db.Uuid
  fromStatus PaymentStatus?
  toStatus   PaymentStatus
  reason     String?
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  payment    Payment        @relation(fields: [paymentId], references: [id])

  @@index([paymentId, createdAt])
  @@map("pay_status_history")
  @@schema("payments")
}

/// État interne du PSP SIMULÉ (jamais utilisé avec un fournisseur réel) : sert au simulateur
/// (confirmation USSD, page 3-D Secure fictive, relevés pour la réconciliation US-7.6).
model PspSimOperation {
  id                String    @id @default(uuid()) @db.Uuid
  provider          String
  reference         String    @unique
  kind              String
  status            String    @default("PENDING")
  amountMinor       BigInt
  currency          String    @db.Char(3)
  merchantReference String
  scenario          String?
  destinationMasked String?
  settledAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  @@index([provider, createdAt])
  @@map("pay_sim_operations")
  @@schema("payments")
}

model PspWebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String
  signatureValid  Boolean
  payload         Json
  result          String
  receivedAt      DateTime  @default(now()) @db.Timestamptz(3)
  processedAt     DateTime? @db.Timestamptz(3)

  @@unique([provider, providerEventId])
  @@map("pay_webhook_events")
  @@schema("payments")
}

/// Payment Gateway : journal des webhooks acceptés (signature valide). Idempotence et
/// non-rejeu par (fournisseur, identifiant d'événement) ; empreinte du corps pour détecter
/// un même identifiant réutilisé avec un contenu différent.
model PaymentGatewayReceipt {
  id                String    @id @default(uuid()) @db.Uuid
  provider          String
  providerEventId   String
  bodySha256        String    @db.Char(64)
  merchantReference String    @db.Uuid
  status            String
  amountMinor       BigInt
  currency          String    @db.Char(3)
  /// RECEIVED (transmission en cours, bail `claimedAt`) → FORWARDED | FORWARD_FAILED
  state             String    @default("RECEIVED")
  /// Début du bail de transmission : une seule requête transmet à la fois ; bail expiré = reprise
  claimedAt         DateTime  @default(now()) @db.Timestamptz(3)
  /// Résultat renvoyé par le Payment Service (PROCESSED, DUPLICATE, AMOUNT_MISMATCH…)
  outcome           String?
  attempts          Int       @default(0)
  lastError         String?
  receivedAt        DateTime  @default(now()) @db.Timestamptz(3)
  forwardedAt       DateTime? @db.Timestamptz(3)

  @@unique([provider, providerEventId])
  @@index([state, receivedAt])
  @@map("pgw_webhook_receipts")
  @@schema("payment_gateway")
}

// ============================================================================
// Notifications
// ============================================================================

model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  key       String
  channel   NotificationChannel
  language  String
  subject   String?
  body      String
  version   Int                 @default(1)
  active    Boolean             @default(true)
  updatedAt DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([key, channel, language])
  @@map("ntf_templates")
  @@schema("notifications")
}

model Notification {
  id           String               @id @default(uuid()) @db.Uuid
  recipientId  String               @db.Uuid
  category     NotificationCategory
  templateKey  String
  eventId      String?              @db.Uuid
  eventType    String?
  priority     NotificationPriority
  channel      NotificationChannel
  status       NotificationStatus   @default(PENDING)
  title        String
  body         String
  data         Json?
  dedupeKey    String?              @unique
  scheduledFor DateTime             @default(now()) @db.Timestamptz(3)
  attempts     Int                  @default(0)
  lastError    String?
  sentAt       DateTime?            @db.Timestamptz(3)
  readAt       DateTime?            @db.Timestamptz(3)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)

  @@index([recipientId, createdAt(sort: Desc)])
  @@index([status, scheduledFor])
  @@map("ntf_notifications")
  @@schema("notifications")
}

/// Journal de livraison des fournisseurs (SMS simulé, SMTP) — propriété de communication-service.
model OutboundMessage {
  id             String          @id @default(uuid()) @db.Uuid
  notificationId String?         @db.Uuid
  /// Destinataire (membre) : limite anti-spam par personne, quel que soit le numéro
  recipientId    String?         @db.Uuid
  priority       String?
  channel        DeliveryChannel
  recipient      String
  subject        String?
  body           String
  provider       String
  status         String
  providerRef    String?
  error          String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)

  @@index([recipient, createdAt(sort: Desc)])
  @@index([recipientId, channel, createdAt])
  @@map("ntf_outbound_messages")
  @@schema("communication")
}

/// Canaux transportés par communication-service.
enum DeliveryChannel {
  SMS
  EMAIL
  PUSH

  @@schema("communication")
}

// ============================================================================
// Conformité
// ============================================================================

model ComplianceRule {
  id             String             @id @default(uuid()) @db.Uuid
  code           String             @unique
  countryCode    String             @db.Char(2)
  ruleType       ComplianceRuleType
  operationTypes OperationType[]
  params         Json
  active         Boolean            @default(true)
  description    String?
  version        Int                @default(1)
  updatedById    String?            @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)

  history ComplianceRuleHistory[]

  @@index([countryCode, active])
  @@map("cmp_rules")
  @@schema("compliance")
}

model ComplianceRuleHistory {
  id          String         @id @default(uuid()) @db.Uuid
  ruleId      String         @db.Uuid
  version     Int
  snapshot    Json
  change      String
  reason      String?
  changedById String?        @db.Uuid
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  rule        ComplianceRule @relation(fields: [ruleId], references: [id])

  @@index([ruleId, version])
  @@map("cmp_rule_history")
  @@schema("compliance")
}

model ComplianceViolation {
  id            String          @id @default(uuid()) @db.Uuid
  memberId      String          @db.Uuid
  operationType OperationType
  ruleCode      String
  action        ViolationAction
  details       Json
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)

  @@index([memberId, createdAt])
  @@map("cmp_violations")
  @@schema("compliance")
}

/// Dossier de conformité : regroupe les alertes d'un membre par type (un seul dossier OPEN par couple).
model ComplianceCase {
  id             String                @id @default(uuid()) @db.Uuid
  memberId       String                @db.Uuid
  type           ComplianceCaseType
  status         ComplianceCaseStatus  @default(OPEN)
  severity       CaseSeverity
  openedAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)
  closedAt       DateTime?             @db.Timestamptz(3)
  closedBy       String?               @db.Uuid
  outcome        CaseOutcome?
  closingComment String?
  version        Int                   @default(1)
  /// Agent assigné (COMPLIANCE_AGENT ou SUPER_ADMIN) ; seul lui ou le super-admin peut clore
  assigneeId     String?               @db.Uuid
  assignedAt     DateTime?             @db.Timestamptz(3)
  alerts         ComplianceCaseAlert[]

  @@index([assigneeId, status])
  @@index([status, openedAt])
  @@index([memberId, status])
  @@map("cmp_cases")
  @@schema("compliance")
}

/// Alerte rattachée à un dossier. `open` : l'alerte source attend encore une décision (AML, doublon).
model ComplianceCaseAlert {
  id         String              @id @default(uuid()) @db.Uuid
  caseId     String              @db.Uuid
  alertType  ComplianceAlertType
  /// Identifiant de l'alerte source (correspondance AML, alerte doublon, violation) ; clé d'idempotence.
  sourceId   String
  summary    Json
  open       Boolean             @default(false)
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)
  resolvedAt DateTime?           @db.Timestamptz(3)
  case       ComplianceCase      @relation(fields: [caseId], references: [id])

  @@unique([alertType, sourceId])
  @@index([caseId])
  @@map("cmp_case_alerts")
  @@schema("compliance")
}

// ============================================================================
// Administration
// ============================================================================

model TontineAccount {
  id          String             @id @default(uuid()) @db.Uuid
  tontineId   String             @db.Uuid
  name        String
  type        TontineAccountType
  rules       Json
  functional  Boolean            @default(false)
  walletId    String?            @db.Uuid
  createdById String             @db.Uuid
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)

  @@unique([tontineId, type])
  @@map("adm_tontine_accounts")
  @@schema("tontines")
}

/// Rapports générés et archivés (rapport final de clôture US-4.9, exports US-10.4, réconciliations).
model GeneratedReport {
  id          String   @id @default(uuid()) @db.Uuid
  tontineId   String?  @db.Uuid
  kind        String
  format      String
  title       String
  sha256      String
  sizeBytes   Int
  content     Bytes
  createdById String?  @db.Uuid
  retainUntil DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([tontineId, kind, createdAt(sort: Desc)])
  @@map("adm_reports")
  @@schema("administration")
}

/// Paramètres modifiables à chaud (A-50) : valeur courante, verrou optimiste par version.
model Configuration {
  key       String   @id
  value     Json
  version   Int      @default(1)
  updatedBy String?  @db.Uuid
  updatedAt DateTime @db.Timestamptz(3)

  @@map("adm_configurations")
  @@schema("administration")
}

/// Historique des modifications de paramètres — ajout seul (trigger).
model ConfigurationHistory {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  /// Version atteinte par cette modification (ordre définitif de l\'historique)
  version   Int
  oldValue  Json?
  newValue  Json
  reason    String
  changedBy String   @db.Uuid
  createdAt DateTime @db.Timestamptz(3)

  @@unique([key, version])
  @@map("adm_configuration_history")
  @@schema("administration")
}

model AdminMessage {
  id             String          @id @default(uuid()) @db.Uuid
  tontineId      String          @db.Uuid
  senderId       String          @db.Uuid
  template       MessageTemplate
  subject        String
  body           String
  filter         Json
  recipientCount Int
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)

  @@index([tontineId, createdAt(sort: Desc)])
  @@map("adm_messages")
