// ============================================================================
// Plateforme
// ============================================================================

model OutboxEvent {
  id            String       @id @db.Uuid
  eventType     String
  eventVersion  Int
  aggregateType String
  aggregateId   String
  producer      String
  correlationId String
  causationId   String?
  payload       Json
  occurredAt    DateTime     @db.Timestamptz(3)
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @db.Timestamptz(3)
  lastError     String?
  publishedAt   DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  seq           BigInt       @default(autoincrement())

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
  @@index([eventType])
  @@map("outbox_events")
  @@schema("platform")
}

model ProcessedEvent {
  consumer    String
  eventId     String   @db.Uuid
  processedAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([consumer, eventId])
  @@map("processed_events")
  @@schema("platform")
}

model IdempotencyKey {
  id             String            @id @default(uuid()) @db.Uuid
  scope          String
  key            String
  userId         String            @db.Uuid
  requestHash    String
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime          @db.Timestamptz(3)

  @@unique([scope, userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
  @@schema("platform")
}

/// Journal d'audit transverse — append-only (trigger).
model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  actorId       String?     @db.Uuid
  actorRole     String?
  action        String
  resourceType  String
  resourceId    String?
  result        AuditResult
  ip            String?
  userAgent     String?
  country       String?
  correlationId String?
  metadata      Json?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
  @@index([result, createdAt])
  @@map("audit_logs")
  @@schema("platform")
}

model JobRun {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  trigger    String
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  status     String
  summary    Json?

  @@index([name, startedAt])
  @@map("job_runs")
  @@schema("platform")
}

// ============================================================================
// Auth
// ============================================================================

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  email                String?               @unique @db.Citext
  phone                String?               @unique
  passwordHash         String?
  role                 PlatformRole          @default(MEMBER)
  status               UserStatus
  firstName            String
  lastName             String
  countryCode          String?               @db.Char(2)
  language             String?
  preferredChannel     CommunicationChannel?
  mfaEnabled           Boolean               @default(false)
  mfaType              MfaType?
  mfaSecretEnc         String?
  mfaPendingSecretEnc  String?
  failedLoginCount     Int                   @default(0)
  lockedUntil          DateTime?             @db.Timestamptz(3)
  lockReason           String?
  lastLoginAt          DateTime?             @db.Timestamptz(3)
  createdById          String?               @db.Uuid
  /// A-04 : tontine réservée par le super-admin lors de la création d'un admin délégué.
  delegatedTontineName String?
  delegatedTontineUsed Boolean               @default(false)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)

  passwordHistory PasswordHistory[]
  tokens          AuthToken[]
  sessions        RefreshSession[]
  recoveryCodes   RecoveryCode[]
  knownDevices    KnownDevice[]
  accessRequests  AccessRequest[]

  @@index([status])
  @@map("auth_users")
  @@schema("auth")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("auth_password_history")
  @@schema("auth")
}

model AuthToken {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  type        AuthTokenType
  tokenHash   String
  expiresAt   DateTime      @db.Timestamptz(3)
  consumedAt  DateTime?     @db.Timestamptz(3)
  revokedAt   DateTime?     @db.Timestamptz(3)
  attempts    Int           @default(0)
  lockedUntil DateTime?     @db.Timestamptz(3)
  metadata    Json?
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, type, createdAt])
  @@map("auth_tokens")
  @@schema("auth")
}

model RefreshSession {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  familyId          String    @db.Uuid
  tokenHash         String    @unique
  deviceFingerprint String
  userAgent         String
  ip                String
  mfaUsed           Boolean   @default(false)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt        DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime  @db.Timestamptz(3)
  rotatedAt         DateTime? @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  revokedReason     String?
  replacedById      String?   @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("auth_refresh_sessions")
  @@schema("auth")
}

model LoginAttempt {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @db.Uuid
  identifierHash String
  ip             String
  userAgent      String
  success        Boolean
  reason         String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([ip, createdAt])
  @@map("auth_login_attempts")
  @@schema("auth")
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
