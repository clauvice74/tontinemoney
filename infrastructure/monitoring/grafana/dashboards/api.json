{
  "title": "TontineMoney API",
  "uid": "tontinemoney-api",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Requêtes HTTP / s",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(rate(http_requests_total[1m])) by (status_class)" }]
    },
    {
      "type": "timeseries",
      "title": "Latence HTTP p95 (s)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Événements outbox en attente",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 6 },
      "targets": [{ "expr": "outbox_pending_events" }]
    },
    {
      "type": "stat",
      "title": "Événements en DLQ",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 6 },
      "targets": [{ "expr": "outbox_dead_events" }]
    },
    {
      "type": "stat",
      "title": "Holds actifs",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 6 },
      "targets": [{ "expr": "wallet_active_holds" }]
    }
  ]
}
