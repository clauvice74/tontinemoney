  "devDependencies": {
    "@swc/core": "1.13.5",
    "@tontine/eslint-config": "workspace:*",
    "@tontine/typescript-config": "workspace:*",
    "@types/node": "22.18.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.39.5",
