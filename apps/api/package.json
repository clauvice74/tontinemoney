{
  "name": "@tontine/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch-path=dist --env-file-if-exists=../../.env dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --config vitest.e2e.config.ts --coverage",
    "openapi": "node --env-file-if-exists=../../.env dist/openapi.js",
    "predev": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation-express": "0.70.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@prisma/client": "7.10.0",
    "@tontine/administration": "workspace:*",
    "@tontine/auth": "workspace:*",
    "@tontine/auth-service": "workspace:*",
    "@tontine/communication": "workspace:*",
    "@tontine/compliance": "workspace:*",
    "@tontine/config": "workspace:*",
    "@tontine/contracts": "workspace:*",
    "@tontine/database": "workspace:*",
    "@tontine/events": "workspace:*",
    "@tontine/kyc": "workspace:*",
    "@tontine/members": "workspace:*",
    "@tontine/notifications": "workspace:*",
    "@tontine/payments": "workspace:*",
    "@tontine/platform": "workspace:*",
    "@tontine/tontines": "workspace:*",
    "@tontine/transactions": "workspace:*",
    "@tontine/wallets": "workspace:*",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.6",
    "@swc/core": "1.13.5",
    "@tontine/eslint-config": "workspace:*",
    "@tontine/typescript-config": "workspace:*",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "3.2.4",
    "concurrently": "9.2.1",
    "eslint": "9.39.5",
    "kafkajs": "2.2.4",
    "supertest": "7.1.4",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.7",
    "vitest": "3.2.4"
  }
}
